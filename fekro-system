<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>fekro® | Executive Workspace</title>
    
    <!-- Meta Tags الاحترافية عشان يظهر بشكل فخم لو بعت اللينك على الواتساب -->
    <meta property="og:title" content="fekro® | Enterprise Workspace">
    <meta property="og:description" content="Official Management Portal for fekro Design Agency.">
    <meta property="og:type" content="website">

    <style>
        :root {
            --bg-deep: #030712;
            --bg-glass: rgba(17, 24, 39, 0.7);
            --bg-card: #0b0f19;
            --border-glow: rgba(255, 42, 42, 0.15);
            --border-muted: #1f2937;
            --text-pure: #ffffff;
            --text-secondary: #9ca3af;
            --accent-red: #ff2a2a;
            --accent-red-hover: #e01b1b;
            --glass-blur: blur(12px);
            --radius-main: 14px;
        }
        .light-mode {
            --bg-deep: #f8fafc;
            --bg-glass: rgba(255, 255, 255, 0.7);
            --bg-card: #ffffff;
            --border-glow: rgba(217, 4, 41, 0.1);
            --border-muted: #e2e8f0;
            --text-pure: #0f172a;
            --text-secondary: #64748b;
            --accent-red: #d90429;
            --accent-red-hover: #b30322;
        }

        body {
            font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-deep); color: var(--text-pure);
            margin: 0; padding: 0; transition: background 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-x: hidden; -webkit-font-smoothing: antialiased;
        }

        header {
            background: var(--bg-glass); backdrop-filter: var(--glass-blur);
            padding: 15px 6%; display: flex; justify-content: space-between; align-items: center;
            border-bottom: 1px solid var(--border-muted); position: sticky; top: 0; z-index: 1000;
        }
        .brand-hub { display: flex; align-items: center; gap: 14px; }
        .dynamic-logo {
            height: 44px; width: auto; object-fit: contain;
            filter: drop-shadow(0 0 12px rgba(255, 42, 42, 0.5));
            animation: pulseGlow 3s infinite ease-in-out;
        }
        .brand-title { font-size: 26px; font-weight: 900; letter-spacing: 2px; text-transform: lowercase; }
        .brand-title span { color: var(--accent-red); }

        .system-controls { display: flex; gap: 12px; }
        .control-trigger {
            background: var(--bg-card); color: var(--text-pure); border: 1px solid var(--border-muted);
            padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600;
            font-size: 13px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .control-trigger:hover { border-color: var(--accent-red); box-shadow: 0 0 15px var(--border-glow); }
        .trigger-executive { background: var(--accent-red); color: white; border: none; }
        .trigger-executive:hover { background: var(--accent-red-hover); transform: translateY(-1px); }

        .showcase-wrapper { max-width: 1100px; margin: 80px auto; padding: 0 25px; text-align: center; }
        .badge { display: inline-block; padding: 6px 14px; background: rgba(255, 42, 42, 0.1); border: 1px solid var(--accent-red); color: var(--accent-red); border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 20px; }
        .showcase-title { font-size: 56px; font-weight: 800; letter-spacing: -1.5px; margin: 0 0 20px 0; line-height: 1.1; }
        .showcase-title span { color: var(--accent-red); }
        .showcase-desc { font-size: 18px; color: var(--text-secondary); max-width: 700px; margin: 0 auto 50px; line-height: 1.7; }
        
        .core-capabilities { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
        .capability-node { background: var(--bg-card); border: 1px solid var(--border-muted); border-radius: var(--radius-main); padding: 35px; text-align: left; transition: all 0.4s ease; position: relative; overflow: hidden; }
        .capability-node:hover { transform: translateY(-6px); border-color: var(--accent-red); box-shadow: 0 10px 30px rgba(0,0,0,0.4); }
        .capability-node::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--accent-red); }

        .workspace-grid { max-width: 1300px; margin: 40px auto; padding: 0 25px; display: none; animation: viewEnter 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
        .workspace-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-muted); padding-bottom: 15px; margin-bottom: 35px; }
        .workspace-title { font-size: 28px; font-weight: 800; letter-spacing: -0.5px; }
        
        .workspace-navigation { display: flex; gap: 8px; }
        .nav-node { background: var(--bg-card); color: var(--text-secondary); border: 1px solid var(--border-muted); padding: 12px 24px; border-radius: 8px; cursor: pointer; font-weight: 700; font-size: 14px; transition: all 0.3s; }
        .nav-node.active { background: var(--accent-red); color: white; border-color: var(--accent-red); }

        .module-card { background: var(--bg-card); border: 1px solid var(--border-muted); border-radius: var(--radius-main); padding: 35px; display: none; }
        .module-card.active { display: block; }

        .orchestrator-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 35px; }
        input, select { background: var(--bg-deep); color: var(--text-pure); border: 1px solid var(--border-muted); padding: 14px 18px; border-radius: 8px; font-size: 14px; box-sizing: border-box; transition: all 0.3s; }
        input:focus, select:focus { border-color: var(--accent-red); outline: none; box-shadow: 0 0 10px rgba(255,42,42,0.1); }
        
        .scroller-axis { display: flex; gap: 10px; margin-bottom: 30px; overflow-x: auto; padding-bottom: 8px; }
        .axis-item { padding: 12px 22px; background: var(--bg-deep); border: 1px solid var(--border-muted); border-radius: 8px; cursor: pointer; font-weight: 600; min-width: 95px; text-align: center; transition: all 0.2s; }
        .axis-item.active { background: var(--accent-red); color: white; border-color: var(--accent-red); }

        .ledger-table { width: 100%; border-collapse: collapse; text-align: left; }
        .ledger-table th, .ledger-table td { padding: 16px; border-bottom: 1px solid var(--border-muted); font-size: 14px; }
        .ledger-table th { background: var(--bg-deep); color: var(--accent-red); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }

        .stream-item { background: var(--bg-deep); padding: 18px 24px; border-radius: 8px; margin-bottom: 12px; border-left: 3px solid var(--accent-red); display: flex; justify-content: space-between; align-items: center; animation: itemEnter 0.3s ease; }

        @keyframes pulseGlow { 0%, 100% { filter: drop-shadow(0 0 8px rgba(255,42,42,0.3)); } 50% { filter: drop-shadow(0 0 18px rgba(255,42,42,0.6)); } }
        @keyframes viewEnter { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes itemEnter { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }

        [dir="rtl"] .ledger-table { text-align: right; }
        [dir="rtl"] .capability-node { text-align: right; }
        [dir="rtl"] .capability-node::before { left: auto; right: 0; }
        [dir="rtl"] .stream-item { border-left: none; border-right: 3px solid var(--accent-red); }
    </style>
</head>
<body>

<header>
    <div class="brand-hub">
        <!-- تم تعديل مسار اللوجو ليكون متوافقاً مع سيرفر جيت هب بدقة -->
        <img src="./logo.png" alt="fekro Logo" class="dynamic-logo" id="brandLogo" onerror="this.style.display='none'">
        <div class="brand-title">fekro<span>.</span></div>
    </div>
    <div class="system-controls">
        <button class="control-trigger" onclick="switchLocalization()" id="langTrigger">العربية</button>
        <button class="control-trigger" onclick="switchThemeEngine()">🌓 Mode</button>
        <button class="control-trigger trigger-executive" onclick="gatewayAuth()" id="gateTrigger">Executive Gate ⚙️</button>
    </div>
</header>

<div id="corporate-view" class="showcase-wrapper">
    <span class="badge">Design Intelligence</span>
    <h1 class="showcase-title" id="showcaseTitle">Deconstruct Complexity.<br>Shape <span>Visual Authority</span>.</h1>
    <p class="showcase-desc" id="showcaseDesc">An elitist digital engineering workspace delivering hyper-premium visual branding, behavioral UI/UX systems, and production framework architectures.</p>

    <div class="core-capabilities">
        <div class="capability-node">
            <h3 style="color: var(--accent-red); margin-top: 0; font-size: 20px;" id="c1-t">High-Tier Branding</h3>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.6; margin-bottom: 0;" id="c1-d">Mathematical execution of identity design, vector guidelines, and high-spec industrial typography systems.</p>
        </div>
        <div class="capability-node">
            <h3 style="color: var(--accent-red); margin-top: 0; font-size: 20px;" id="c2-t">UI/UX Architecture</h3>
            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.6; margin-bottom: 0;" id="c2-d">Advanced user interface logic mapping, system component wireframing, and custom web asset delivery.</p>
        </div>
    </div>
</div>

<div class="workspace-grid" id="executiveSuite">
    <div class="workspace-header">
        <div class="workspace-title" id="suiteTitle">Executive Management Suite</div>
        <div class="workspace-navigation">
            <button class="nav-node active" onclick="activateSubModule('mod-tasks', this)" id="nav-t">Tasks Matrix</button>
            <button class="nav-node" onclick="activateSubModule('mod-memos', this)" id="nav-m">Internal Memo</button>
            <button class="nav-node" onclick="activateSubModule('mod-ledger', this)" id="nav-l">Financial Ledger</button>
        </div>
    </div>

    <div id="mod-tasks" class="module-card active">
        <h3 style="margin-top:0;" id="h-dispatch">Dispatch Operational Task</h3>
        <div class="orchestrator-row">
            <input type="text" id="taskTitle" placeholder="Task description...">
            <select id="taskDay">
                <option value="Sat">Saturday</option><option value="Sun">Sunday</option><option value="Mon">Monday</option>
                <option value="Tue">Tuesday</option><option value="Wed">Wednesday</option><option value="Thu">Thursday</option>
            </select>
            <select id="taskAssignee">
                <option value="Omar Fekry">Omar Fekry (Director)</option>
                <option value="Khaled Hassan">Khaled Hassan (Director)</option>
                <option value="Adam Mady">Adam Mady</option>
                <option value="Omar Mousa">Omar Mousa</option>
                <option value="Rahma Ehab">Rahma Ehab</option>
                <option value="Jana Awad">Jana Awad</option>
            </select>
            <button class="control-trigger trigger-executive" onclick="executeTaskCommit()" id="btn-assign">Assign 🎯</button>
        </div>
        <div class="scroller-axis">
            <div class="axis-item active" onclick="axisFilter('Sat', this)">Sat</div>
            <div class="axis-item" onclick="axisFilter('Sun', this)">Sun</div>
            <div class="axis-item" onclick="axisFilter('Mon', this)">Mon</div>
            <div class="axis-item" onclick="axisFilter('Tue', this)">Tue</div>
            <div class="axis-item" onclick="axisFilter('Wed', this)">Wed</div>
            <div class="axis-item" onclick="axisFilter('Thu', this)">Thu</div>
        </div>
        <div id="tasksRenderBox"></div>
    </div>

    <div id="mod-memos" class="module-card">
        <h3 style="margin-top:0;" id="h-memo">Private Board Note</h3>
        <div class="orchestrator-row" style="grid-template-columns: 3fr 1fr;">
            <input type="text" id="memoText" placeholder="Log incoming orders, direct calls, or sensitive notes...">
            <button class="control-trigger trigger-executive" onclick="executeMemoCommit()" id="btn-memo">Save Note 📌</button>
        </div>
        <div id="memosRenderBox"></div>
    </div>

    <div id="mod-ledger" class="module-card">
        <h3 style="margin-top:0;" id="h-ledger">Granular Bookkeeping</h3>
        <div class="orchestrator-row">
            <input type="text" id="finDesc" placeholder="Transaction details...">
            <input type="number" id="finAmount" placeholder="Value (EGP)...">
            <select id="finType">
                <option value="in">Inflow (Revenue) 🟢</option>
                <option value="out">Outflow (Expense) 🔴</option>
            </select>
            <button class="control-trigger trigger-executive" onclick="executeFinanceCommit()" id="btn-fin">Log Movement 📝</button>
        </div>
        <table class="ledger-table">
            <thead>
                <tr><th id="th1">Description</th><th id="th2">Amount</th><th id="th3">Type</th><th id="th4">Date</th></tr>
            </thead>
            <tbody id="ledgerRows"></tbody>
        </table>
    </div>
</div>

<script>
let activeLang = 'en';
let selectedAxisDay = 'Sat';
let gateUnlocked = false;

const i18n = {
    en: {
        showcaseTitle: "Deconstruct Complexity.<br>Shape <span>Visual Authority</span>.",
        showcaseDesc: "An elitist digital engineering workspace delivering hyper-premium visual branding, behavioral UI/UX systems, and production framework architectures.",
        c1T: "High-Tier Branding", c1D: "Mathematical execution of identity design, vector guidelines, and high-spec industrial typography systems.",
        c2T: "UI/UX Architecture", c2D: "Advanced user interface logic mapping, system component wireframing, and custom web asset delivery.",
        gateTrigger: "Executive Gate ⚙️", langTrigger: "العربية",
        suiteTitle: "Executive Management Suite", navT: "Tasks Matrix", navM: "Internal Memo", navL: "Financial Ledger",
        hDispatch: "Dispatch Operational Task", btnAssign: "Assign 🎯", hMemo: "Private Board Note", btnMemo: "Save Note 📌",
        hLedger: "Granular Bookkeeping", btnFin: "Log Movement 📝", th1: "Description", th2: "Amount", th3: "Type", th4: "Date"
    },
    ar: {
        showcaseTitle: "تفكيك التعقيد والمرئيات.<br>صناعة <span>النفوذ البصري</span>.",
        showcaseDesc: "مساحة عمل هندسية رقمية نخبوية تقدم خدمات البراندنج البصري الفاخر، واجهات الاستخدام السلوكية المعقدة، وتقنيات الإنتاج المتقدمة.",
        c1T: "تصميم الهويات الفاخرة", c1D: "تنفيذ هندسي دقيق للهويات البصرية، الخطوط الصناعية الخاصة، وكتيبات الإرشاد الفني المتكاملة.",
        c2T: "هندسة واجهات الـ UI/UX", c2D: "رسم خرائط منطق التفاعل الرقمي المتقدم، تخطيط المكونات الهيكلية، وتسليم الأصول الرقمية المخصصة للمواقع.",
        gateTrigger: "بوابة المديرين ⚙️", langTrigger: "English",
        suiteTitle: "غرفة العمليات الإدارية العليا", navT: "مصفوفة المهام", navM: "المفكرة والطلبات", navL: "الحسابات والجرد المالي",
        hDispatch: "تكليف وإسناد مهمة تشغيلية", btnAssign: "إسناد 🎯", hMemo: "الملاحظات الخاصة بمجلس الإدارة", btnMemo: "حفظ الملاحظة 📌",
        hLedger: "منظومة الحسابات والجرد الدقيق بالملي", btnFin: "تسجيل حركة 📝", th1: "البيان", th2: "المبلغ", th3: "النوع", th4: "التاريخ"
    }
};

function switchLocalization() {
    activeLang = activeLang === 'en' ? 'ar' : 'en';
    document.documentElement.dir = activeLang === 'ar' ? 'rtl' : 'ltr';
    document.documentElement.lang = activeLang;
    
    const data = i18n[activeLang];
    document.getElementById('langTrigger').innerText = data.langTrigger;
    document.getElementById('gateTrigger').innerText = data.gateTrigger;
    document.getElementById('showcaseTitle').innerHTML = data.showcaseTitle;
    document.getElementById('showcaseDesc').innerText = data.showcaseDesc;
    document.getElementById('c1-t').innerText = data.c1T; document.getElementById('c1-d').innerText = data.c1D;
    document.getElementById('c2-t').innerText = data.c2T; document.getElementById('c2-d').innerText = data.c2D;
    
    document.getElementById('suiteTitle').innerText = data.suiteTitle;
    document.getElementById('nav-t').innerText = data.navT; document.getElementById('nav-m').innerText = data.navM; document.getElementById('nav-l').innerText = data.navL;
    document.getElementById('h-dispatch').innerText = data.hDispatch; document.getElementById('btn-assign').innerText = data.btnAssign;
    document.getElementById('h-memo').innerText = data.hMemo; document.getElementById('btn-memo').innerText = data.btnMemo;
    document.getElementById('h-ledger').innerText = data.hLedger; document.getElementById('btn-fin').innerText = data.btnFin;
    document.getElementById('th1').innerText = data.th1; document.getElementById('th2').innerText = data.th2; document.getElementById('th3').innerText = data.th3; document.getElementById('th4').innerText = data.th4;
}

function switchThemeEngine() { document.body.classList.toggle('light-mode'); }

function gatewayAuth() {
    if(gateUnlocked) {
        document.getElementById('corporate-view').style.display = 'block';
        document.getElementById('executiveSuite').style.display = 'none';
        gateUnlocked = false;
        document.getElementById('gateTrigger').style.background = 'var(--accent-red)';
        return;
    }
    let secret = prompt(activeLang === 'ar' ? "أدخل رمز الولوج التنفيذي لمجلس الإدارة:" : "Enter Executive Control Code:");
    if(secret === "fekro2026") {
        gateUnlocked = true;
        document.getElementById('corporate-view').style.display = 'none';
        document.getElementById('executiveSuite').style.display = 'flex';
        document.getElementById('gateTrigger').style.background = '#10b981';
        document.getElementById('gateTrigger').innerText = activeLang === 'ar' ? "الخروج للواجهة 🌐" : "Exit Workspace 🌐";
        pullTasks();
    } else {
        alert(activeLang === 'ar' ? "صلاحية محظورة!" : "Access Denied!");
    }
}

function activateSubModule(modId, tabNode) {
    document.querySelectorAll('.module-card').forEach(m => m.classList.remove('active'));
    document.querySelectorAll('.nav-node').forEach(t => t.classList.remove('active'));
    document.getElementById(modId).classList.add('active');
    tabNode.classList.add('active');
    if(modId === 'mod-memos') pullMemos();
    if(modId === 'mod-ledger') pullFinance();
}

function axisFilter(day, element) {
    document.querySelectorAll('.axis-item').forEach(i => i.classList.remove('active'));
    element.classList.add('active');
    selectedAxisDay = day;
    pullTasks();
}

if(!localStorage.getItem('fk_db_t')) localStorage.setItem('fk_db_t', JSON.stringify([]));
if(!localStorage.getItem('fk_db_m')) localStorage.setItem('fk_db_m', JSON.stringify([]));
if(!localStorage.getItem('fk_db_l')) localStorage.setItem('fk_db_l', JSON.stringify([]));

function executeTaskCommit() {
    const title = document.getElementById('taskTitle').value.trim();
    const day = document.getElementById('taskDay').value;
    const assignee = document.getElementById('taskAssignee').value;
    if(!title) return;
    let d = JSON.parse(localStorage.getItem('fk_db_t'));
    d.push({ title, day, assignee });
    localStorage.setItem('fk_db_t', JSON.stringify(d));
    document.getElementById('taskTitle').value = "";
    pullTasks();
}

function pullTasks() {
    let d = JSON.parse(localStorage.getItem('fk_db_t'));
    let box = document.getElementById('tasksRenderBox'); box.innerHTML = "";
    let match = d.filter(t => t.day === selectedAxisDay);
    if(match.length === 0) { box.innerHTML = `<p style="color:var(--text-secondary); text-align:center;">No operations logged.</p>`; return; }
    match.forEach(t => {
        box.innerHTML += `<div class="stream-item"><div><strong>${t.title}</strong><br><small style="color:var(--text-secondary)">Resource: ${t.assignee}</small></div></div>`;
    });
}

function executeMemoCommit() {
    const txt = document.getElementById('memoText').value.trim();
    if(!txt) return;
    let d = JSON.parse(localStorage.getItem('fk_db_m')); d.push(txt);
    localStorage.setItem('fk_db_m', JSON.stringify(d));
    document.getElementById('memoText').value = "";
    pullMemos();
}

function pullMemos() {
    let d = JSON.parse(localStorage.getItem('fk_db_m'));
    let box = document.getElementById('memosRenderBox'); box.innerHTML = "";
    if(d.length === 0) { box.innerHTML = `<p style="color:var(--text-secondary); text-align:center;">Memo pad clear.</p>`; return; }
    d.forEach(m => { box.innerHTML += `<div class="stream-item"><div>📌 ${m}</div></div>`; });
}

function executeFinanceCommit() {
    const desc = document.getElementById('finDesc').value.trim();
    const amount = document.getElementById('finAmount').value;
    const type = document.getElementById('finType').value;
    if(!desc || !amount) return;
    let d = JSON.parse(localStorage.getItem('fk_db_l'));
    d.push({ desc, amount, type, date: new Date().toLocaleDateString() });
    localStorage.setItem('fk_db_l', JSON.stringify(d));
    document.getElementById('finDesc').value = ""; document.getElementById('finAmount').value = "";
    pullFinance();
}

function pullFinance() {
    let d = JSON.parse(localStorage.getItem('fk_db_l'));
    let rows = document.getElementById('ledgerRows'); rows.innerHTML = "";
    d.forEach(f => {
        rows.innerHTML += `<tr><td>${f.desc}</td><td style="color:${f.type==='in'?'#10b981':'var(--accent-red)'}">${f.amount} EGP</td><td>${f.type.toUpperCase()}</td><td>${f.date}</td></tr>`;
    });
}
</script>
</body>
</html>
